# Copy values into your shell or hosting environment. This file is not auto-loaded.
# For deployment, set ADMIN_KEY to a unique private value of at least 32 characters.
# Keep the key out of frontend/config.js and source control; production rejects the local demo key.
APP_ENV=development
ADMIN_KEY=admindash
# Use an absolute persistent-disk path when hosted.
DATABASE_PATH=backend/data/smartmart.db
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
